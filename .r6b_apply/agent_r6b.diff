+# ── R6b NUMBER/UNIT NORMALIZER (post-LLM TTS safety net) ──────────────────────────────
+# The prompt BANS digits/₹/RS/"sq. ft" and tells the model to speak words ("पचासी लाख rupees",
+# "square feet"), but a 17B model occasionally leaks a symbol/abbreviation. This is a
+# DETERMINISTIC last line of defence applied in _MirrorAgent.tts_node — it rewrites the text
+# AFTER the LLM and BEFORE the TTS, so a stray "₹85 लाख" / "850 sq. ft" is spoken correctly
+# instead of the TTS reading "rupee-symbol" / "ess-cue-dot-ef-tee". It is CONSERVATIVE on
+# purpose: it normalises currency SYMBOLS + unit/scale ABBREVIATIONS to words (the things TTS
+# garbles) but does NOT try to spell out bare digits (the deferred A3b experiment proved
+# digit-to-Hindi-words mangles dates/ranges — that stays the prompt's job). Touches ONLY the
+# text stream; it NEVER touches the TTS constructor / voice settings (THE LAW). Never raises.
+_RE_SQFT = re.compile(r"\bsq\.?\s*ft\.?|\bsqft\b|\bsq\s*feet\b", re.IGNORECASE)
+_RE_RUPEE_SYMBOL = re.compile(r"₹\s*")                     # "₹85" -> "85 ... rupees"
+_RE_RS_PREFIX = re.compile(r"\b(?:RS|Rs|Rs\.)\s*(?=[\d०-९])", re.IGNORECASE)  # "Rs 200" -> "200 rupees"
+_RE_CRORE = re.compile(r"(?<=[\d०-९])\s*(?:Cr|crore)\b", re.IGNORECASE)
+_RE_LAKH = re.compile(r"(?<=[\d०-९])\s*(?:L|Lac|Lakh)\b", re.IGNORECASE)
+
+
+def _normalize_speech_units(text: str) -> str:
+    """Rewrite TTS-garbling currency symbols + unit/scale abbreviations to spoken words.
+    Conservative, deterministic, never raises. Examples:
+      "₹85 लाख"      -> "85 लाख rupees"
+      "Rs 200"        -> "200 rupees"
+      "850 sq. ft"    -> "850 square feet"
+      "6.13 Cr"       -> "6.13 crore"   ;  "85L" -> "85 lakh"
+    (Bare digits are left as-is — the prompt + EL text-normalization handle spelling them.)"""
+    if not text:
+        return text or ""
+    try:
+        out = text
+        # sq.ft family -> "square feet" (do this first so the dot isn't read aloud)
+        out = _RE_SQFT.sub("square feet", out)
+        # scale abbreviations attached to a number -> words
+        out = _RE_CRORE.sub(" crore", out)
+        out = _RE_LAKH.sub(" lakh", out)
+        # currency: "₹85" -> "85 rupees" ; "Rs 200" -> "200 rupees".
+        # We move the unit AFTER the number (how it is spoken in Hindi/English) by tagging a
+        # trailing " rupees". To avoid double-tagging when "rupees"/"rupaye" already follows,
+        # only append when not already present right after.
+        def _rupee_repl(m: "re.Match") -> str:  # noqa: F821
+            return ""  # drop the leading symbol/prefix; the trailing word is added below
+        # find the rupee marker position BEFORE we strip it, so we can place "rupees"
+        # right after the amount phrase that FOLLOWS the marker (not the first number anywhere).
+        mk = _RE_RUPEE_SYMBOL.search(out) or _RE_RS_PREFIX.search(out)
+        had_rupee = bool(mk)
+        mk_pos = mk.start() if mk else -1
+        out = _RE_RUPEE_SYMBOL.sub(_rupee_repl, out)
+        out = _RE_RS_PREFIX.sub("", out)
+        if had_rupee and "rupee" not in out.lower() and "rupaye" not in out.lower() and "रुपये" not in out:
+            # the amount phrase = a number run + ANY trailing scale words (लाख/करोड़/हज़ार/
+            # crore/lakh/thousand), so "85 लाख" -> "85 लाख rupees" (not "85 rupees लाख").
+            # Search from the original marker position so we tag the RIGHT amount.
+            scan_from = max(0, mk_pos)
+            amt = re.compile(
+                r"[\d०-९][\d,.०-९\s]*"
+                r"(?:\s*(?:लाख|करोड़|हज़ार|हजार|crore|cr|lakh|lac|thousand|hazaar))*",
+                re.IGNORECASE,
+            )
+            m = amt.search(out, scan_from) or amt.search(out)
+            if m and m.group().strip():
+                end = m.end()
+                head = out[:end].rstrip()
+                tail = out[end:]
+                sep = "" if tail[:1] in (" ", "") else " "
+                out = head + " rupees" + sep + tail
+            else:
+                out = out.rstrip() + " rupees"
+        # collapse any double spaces we introduced
+        out = re.sub(r"[ \t]{2,}", " ", out)
+        return out.strip() or (text or "")
+    except Exception:  # noqa: BLE001
+        return text or ""
+
