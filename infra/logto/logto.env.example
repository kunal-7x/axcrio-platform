# Copy to logto.env on the box, fill real values, chmod 600. NEVER commit the real file.
# Used by BOTH the logto-postgres container (POSTGRES_PASSWORD) and the logto container (DB_URL).
# The password in DB_URL MUST equal POSTGRES_PASSWORD.

# --- Postgres (the dedicated Logto DB; separate from Hatchet's broker PG) ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM

# --- Logto core ---
# DB_URL host = the compose service name "logto-postgres" (internal docker network).
DB_URL=postgres://logto_app:CHANGE_ME_STRONG_RANDOM@logto-postgres:5432/logto

# --- Production endpoint (LEAVE UNSET until auth.famit.in DNS/TLS exist) ---
# When set, this becomes the OIDC issuer base: issuer = {ENDPOINT}/oidc.
# Until then, omit both so Logto defaults to http://localhost:3001 / :3002 (tunnel-friendly).
# ENDPOINT=https://auth.famit.in
# ADMIN_ENDPOINT=https://auth.famit.in
