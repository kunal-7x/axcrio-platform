# voice-agent-v2 env contract (NO SECRETS HERE — real values live only in /opt/famit-agent-v2/.env on the box)
#
# EASIEST: copy the live /opt/famit-agent/.env to /opt/famit-agent-v2/.env and change ONLY the
# three lines marked ★ below. Everything else (voice tuning, keys, endpointing) is inherited
# identically so the voice is byte-for-byte the same.

# ── ★ the only v2-specific changes ───────────────────────────────────────────
GROQ_LLM_MODEL=llama-3.3-70b-versatile        # ★ the bigger, more robust brain (was llama-4-scout-17b)
LIVEKIT_AGENT_NAME=capsy-v2                    # ★ runs as a SEPARATE worker next to live "capsy"
AGENT_HTTP_PORT=8091                           # ★ distinct health port (live uses 8090)

# ── inherited from the live .env (do NOT change — keep the voice identical) ───
# Secrets (set to the SAME values as the live box; never commit real values):
#   LIVEKIT_URL=...  LIVEKIT_API_KEY=...  LIVEKIT_API_SECRET=...
#   ELEVENLABS_API_KEY=...      GROQ_API_KEY=...  GROQ_API_KEY_2.._N=...   SARVAM_API_KEY=...(+_2.._N)
# Voice / brain tuning (golden — keep as live):
#   ELEVENLABS_VOICE_ID=QTKSa2Iyv0yoxvXY2V8a   ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
#   EL_STABILITY=0.55   EL_SIMILARITY=0.80   EL_SPEED=1.08
#   SARVAM_STT_MODEL=saarika:v2.5   SARVAM_STT_LANG=unknown
#   GROQ_LLM_TEMPERATURE=0.3   GROQ_MAX_TOKENS=90   GROQ_FALLBACK=1
#   MIN_EP_DELAY=0.25  MAX_EP_DELAY=0.45  MIN_INT_DUR=0.25
#   LANG_MIRROR_V2=...  LANG_MIRROR_FLOOR=0.30  LANG_TTS_NUDGE=1
#   OPENER_IN_CTX=1  OPENER_ALREADY_SAID=1  OPENER_DELAY_S=0.8
#   BOOKING_HTTP_ENABLED=1  BOOKING_HTTP_URL=http://127.0.0.1:8209/booking/book
#   KERNEL_OUTBOUND=0
