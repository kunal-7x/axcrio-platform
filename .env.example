# Local LiveKit server
# Start it with: livekit-server --dev
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Agent registration. This must match the LiveKit dispatch rule agent name.
LIVEKIT_AGENT_NAME=voice-assistant

# Provider selection
# STT_PROVIDER: elevenlabs or sarvam
# TTS_PROVIDER: sarvam or elevenlabs
STT_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs

# Groq LLM
GROQ_API_KEY=gsk_xxxxxxxxxxxxx
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_LLM_TEMPERATURE=0.25
GROQ_LLM_MAX_COMPLETION_TOKENS=64

# Realtime latency tuning
AGENT_PERSON_NAME=Riya
COMPANY_NAME=Axcrio Enterprises
AGENT_GREETING_TEXT=Namaste, main Riya bol rahi hun Axcrio Enterprises se. Aapki property enquiry ke follow-up ke liye call kiya tha, kya abhi baat ho sakti hai?
AGENT_MIN_ENDPOINTING_DELAY=0.1
AGENT_MAX_ENDPOINTING_DELAY=0.4
AGENT_AEC_WARMUP_DURATION=0
AGENT_MIN_INTERRUPTION_DURATION=0.25
AGENT_MIN_INTERRUPTION_WORDS=2
AGENT_FALSE_INTERRUPTION_TIMEOUT=0.5
AGENT_RESUME_FALSE_INTERRUPTION=false

# Local RAG knowledge
KNOWLEDGE_ENABLED=true
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_TOP_K=2
KNOWLEDGE_MAX_CHARS=500
KNOWLEDGE_CHUNK_CHARS=650
KNOWLEDGE_MIN_SCORE=0.45
SALES_BRAIN_ENABLED=false
SALES_BRAIN_FILE=knowledge/groq_real_estate_sales_brain.md
SALES_BRAIN_MAX_CHARS=1200

# ElevenLabs STT/TTS
ELEVEN_API_KEY=sk_xxxxxxxxxxxxx
ELEVEN_STT_MODEL=scribe_v2_realtime
ELEVEN_STT_LANGUAGE=hi
ELEVEN_STT_SAMPLE_RATE=16000
ELEVEN_STT_SERVER_VAD=true
ELEVEN_STT_VAD_SILENCE_THRESHOLD_SECS=0.4
ELEVEN_STT_VAD_THRESHOLD=0.35
ELEVEN_STT_MIN_SPEECH_DURATION_MS=120
ELEVEN_STT_MIN_SILENCE_DURATION_MS=400
ELEVEN_TTS_MODEL=eleven_flash_v2_5
ELEVEN_TTS_LANGUAGE=hi
# Must be a voice this ElevenLabs API key can synthesize.
ELEVEN_TTS_VOICE_ID=l7kNoIfnJKPg7779LI2t
ELEVEN_TTS_AUTO_MODE=true
ELEVEN_TTS_STREAMING_LATENCY=1
ELEVEN_TTS_CHUNK_LENGTH_SCHEDULE=50,80,120
ELEVEN_TTS_ENCODING=mp3_22050_32
ELEVEN_TTS_SYNC_ALIGNMENT=false
ELEVEN_TTS_TEXT_NORMALIZATION=off
ELEVEN_TTS_LANGUAGE_TEXT_NORMALIZATION=false
ELEVEN_TTS_ENABLE_LOGGING=false

# Sarvam STT
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_HIGH_VAD_SENSITIVITY=true

# Sarvam TTS
SARVAM_API_KEY=sk_xxxxxxxxxxxxx
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=suhani
SARVAM_TTS_PACE=1.1
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_MIN_BUFFER_SIZE=30
SARVAM_TTS_MAX_CHUNK_LENGTH=80
SARVAM_TTS_ENABLE_PREPROCESSING=false
SARVAM_TTS_OUTPUT_AUDIO_BITRATE=32k
SARVAM_TTS_ENABLE_CACHED_RESPONSES=true
SARVAM_TTS_CODEC=mp3

# Vobiz SIP trunk credentials
VOBIZ_SIP_DOMAIN=your_unique_domain.sip.vobiz.ai
VOBIZ_SIP_TRANSPORT=udp
VOBIZ_USERNAME=your_vobiz_sip_username
VOBIZ_PASSWORD=your_vobiz_sip_password
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX
SALES_CALLBACK_NUMBER=${VOBIZ_PHONE_NUMBER}

# Created by scripts/setup_vobiz_trunk.py
LIVEKIT_SIP_TRUNK_ID=
CALL_RINGING_TIMEOUT_SECONDS=45
