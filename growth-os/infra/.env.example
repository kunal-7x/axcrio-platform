# GROWTH OS dev env (copy to .env; NEVER commit real secrets — P6 token vault).
# These match infra/docker-compose.dev.yml. Services read these via packages/config (zod-validated).

# ---- Postgres (OLTP, RLS) ----
DATABASE_URL=postgres://growthos:growthos_dev@localhost:5432/growthos

# ---- Redpanda (Kafka API) + Schema Registry ----
KAFKA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- ClickHouse ----
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=growthos
CLICKHOUSE_PASSWORD=growthos_dev
CLICKHOUSE_DB=growthos

# ---- Temporal ----
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ---- MinIO (S3) ----
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=growthos
S3_SECRET_KEY=growthos_dev
S3_BUCKET=growthos-dev

# ---- Auth (D5 Phase-0 dev JWT stub; OIDC swaps in Phase 3) ----
JWT_DEV_SECRET=dev-only-change-me
AUTH_MODE=dev

# ---- Origin Platform Connector (Tenant Zero bridge; per-connection service token) ----
# Set when wiring the live Famit platform (later, flag-gated). Mirrors AIASSET_SERVICE_TOKEN.
ORIGIN_SERVICE_TOKEN=

# ---- LLM Gateway (P8; no raw SDK calls in services) ----
# Reuse live keys. NOTE founder typo on the live box: OPNEROUTER_API_KEY (fallback OPENROUTER_API_KEY).
OPENROUTER_API_KEY=
