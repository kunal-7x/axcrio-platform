{
  "name": "@growth-os/core",
  "version": "0.0.0",
  "private": true,
  "description": "GROWTH OS core — ONE modular NestJS(Fastify) app (D1): gateway + tenants + flags + ledger + notify + billing-stub. Phase-0 deploy. Contracts-first (P1).",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0 || true",
    "test": "vitest run",
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "node --import tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@growth-os/auth": "workspace:*",
    "@growth-os/config": "workspace:*",
    "@growth-os/events": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "ajv": "^8.17.1",
    "fastify": "^4.28.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
