# GROWTH OS core — Phase-0 env (copy to .env). Sane laptop defaults: the app boots with
# NO db/bus (degraded) so the contract surface is exercisable. Real Postgres/Redpanda = box/CI.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Postgres (box/CI). Absent => app boots in no-db mode (DB endpoints return errors). ---
# DATABASE_URL=postgres://growthos:growthos@localhost:5432/growthos
# DB_DISABLED=false

# --- Event bus. Absent KAFKA_BROKERS => in-memory bus (correct for the laptop, D8). ---
# KAFKA_BROKERS=localhost:9092
# BUS_MEMORY=false

# --- Phase-0 dev auth stub (D5). NEVER used in prod (Phase 3 swaps to Logto OIDC). ---
AUTH_DEV_SECRET=growth-os-phase0-dev-secret-not-for-prod
# DEV_TOKEN_ENABLED auto-off when NODE_ENV=production.

# --- Ledger signing (HS256 over canonical plan bytes Phase 0; ed25519 later). ---
LEDGER_SIGNER_KEY_ID=ledger-dev-key-1
LEDGER_SIGNING_SECRET=growth-os-phase0-ledger-secret-not-for-prod

# --- Origin Connector service token (mirrors live AIASSET_SERVICE_TOKEN). Phase 1 wiring. ---
# ORIGIN_SERVICE_TOKEN=

# --- OTel (P10). Absent => traces stay in-process. ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=growth-os-core
