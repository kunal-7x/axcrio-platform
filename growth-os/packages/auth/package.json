{
  "name": "@growth-os/auth",
  "version": "0.0.0",
  "private": true,
  "description": "GROWTH OS auth interface + Phase-0 dev JWT stub (D5). OIDC-shaped AuthContext; tenant from token never body (P6). OIDC issuer (Logto) swaps in Phase 3 behind this same interface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0 || true",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
