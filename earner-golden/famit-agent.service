[Unit]
Description=Famit Voice Agent (native livekit-agents, Riya/Godrej)
After=network.target

[Service]
User=famit
WorkingDirectory=/opt/famit-agent
EnvironmentFile=/opt/famit-agent/.env
Environment=PYTHONPATH=/opt/famit-agent
ExecStart=/opt/capsy-agent/.venv/bin/python /opt/famit-agent/agent.py start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
