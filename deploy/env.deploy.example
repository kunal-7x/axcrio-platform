# ===========================================================================
# Haptica AI — backend deploy env.  Copy this to  deploy/.env.deploy  (which is
# gitignored) and fill REAL values. EASIEST + most reliable: copy the box's
# existing working backend env verbatim:   cp droplet_work/.env deploy/.env.deploy
# then add PANEL_PORT below. NEVER commit the filled file.
# ===========================================================================

# Host port the panel is published on (kept OFF 80/443 so the live site is safe)
PANEL_PORT=3100

# ---- LiveKit (backend signs join tokens) ----
LIVEKIT_URL=wss://YOUR_LIVEKIT_HOST
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- LLM / STT / TTS providers ----
GROQ_API_KEY=
ELEVEN_API_KEY=
SARVAM_API_KEY=

# ---- Vobiz SIP trunk (outbound calling) ----
VOBIZ_SIP_DOMAIN=
VOBIZ_USERNAME=
VOBIZ_PASSWORD=
VOBIZ_PHONE_NUMBER=

# ---- DigitalOcean Spaces (Creative Studio assets via presigned URLs) ----
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=

# ---- Copy ANY other keys the box's droplet_work/.env defines (admin seed,
#      webhook secrets, etc.) so caller.py has everything it expects. ----
