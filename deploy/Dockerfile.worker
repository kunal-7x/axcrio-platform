# syntax=docker/dockerfile:1
# Haptica AI — voice agent worker (droplet_work/agent.py = "Riya").
# Mirrors the local `run_worker.py` setup: same livekit-agents stack, same
# modules, same baked model weights. Build context MUST be the repo root.
#   docker build -f deploy/Dockerfile.worker -t haptica-worker .
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 FAMIT_VAR=/data \
    HF_HOME=/app/.cache/huggingface
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data

# deps — identical set to README "Run locally"
RUN pip install --no-cache-dir \
    "livekit-agents[elevenlabs,groq,sarvam,silero,turn-detector,openai,deepgram]~=1.3" \
    livekit-api httpx python-dotenv protobuf numpy

# agent source + every module it imports (voice_kernel/voice_ops are optional
# adapters the agent tries to import; include them for full local parity)
COPY droplet_work/ ./droplet_work/
COPY voice_kernel/ ./voice_kernel/
COPY voice_ops/ ./voice_ops/
COPY knowledge/ ./knowledge/

# bake model weights (Silero VAD + turn detector) so the FIRST call is instant
WORKDIR /app/droplet_work
RUN python agent.py download-files || true

# run the production worker; all tuning (model, temp, agent_name, …) comes from
# the compose `environment:` block, matching run_worker.py exactly.
CMD ["python", "agent.py", "start"]
